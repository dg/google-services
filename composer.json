{
	"name": "dg/google-services",
	"description": "📬 Google Services: ergonomic PHP wrappers for Gmail, Calendar, Meet and Slides over the official API client, plus an MCP server that gives them to Claude and other AI assistants.",
	"keywords": ["google api", "gmail", "google calendar", "google meet", "google slides", "mcp", "ai"],
	"type": "library",
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": ">=8.2",
        "google/apiclient": "^2.18",
        "mcp/sdk": "^0.9",
        "symfony/finder": "^7.0 || ^8.0",
		"nette/mail": "^4.1",
		"nette/utils": "^4.1"
    },
	"require-dev": {
		"phpstan/phpstan": "^2.1@stable",
		"phpstan/extension-installer": "^1.4@stable",
		"nette/phpstan-rules": "^1.0",
		"nette/tester": "^2.6"
	},
	"autoload": {
		"classmap": ["src/"]
	},
	"scripts": {
		"phpstan": "phpstan analyse"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true,
			"php-http/discovery": true
		}
	}
}
